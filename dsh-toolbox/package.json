{
  "name": "dsh-toolbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A toolbox panel in the DSH Web GUI sidebar: a card grid with a JSON formatter and an XML formatter.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "toolbox",
    "json",
    "xml",
    "formatter",
    "utilities",
    "ui"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
